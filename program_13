{
    int ch,val;
    node *new_node, *temp;
    printf("\nProgram For Binary Search Tree ");
    while(1)
    {
        printf("\n1.Insert an Element\n2.Search\n3.Recursive Traversals\n4.Delete a Node\n5. Exit");
        printf("\nEnter your Option : ");
