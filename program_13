#include<stdio.h>
#include<stdlib.h>
struct BST
{
    struct BST *lchild;
    int data;
    struct BST *rchild;
};
typedef struct BST node;
node *root=NULL, *temp;

void inorder(node *tree){
    if(tree!=NULL){
        inorder(tree->lchild);
        printf(" %d ",tree->data);
        inorder(tree->rchild);
 }
}

void preorder(node *tree){
    if(tree!=NULL){
        printf(" %d ",tree->data);
        preorder(tree->lchild);
        preorder(tree->rchild);
    }
}

void postorder(node *tree){
    if(tree!=NULL){
        postorder(tree->lchild);
        postorder(tree->rchild);
        printf(" %d ",tree->data);
    }
}

void insert(node *root, node *new_node)
{
    if(new_node->data < root->data)
    {
        if (root->lchild == NULL)
            root->lchild = new_node;
        else
            insert(root->lchild, new_node);
    }
    else if (new_node->data >= root->data)
    {
        if (root->rchild == NULL)
                root->rchild = new_node;
        else
                insert(root->rchild, new_node);
    }
}

void search(int val)
{
    node *temp=root;
    while (temp != NULL)
    {
        if (temp->data == val)
            break;
        if (temp->data > val)
            temp = temp->lchild;
        else
            temp = temp->rchild;
    }
    if(temp!=NULL)
            printf("Element %d is found\n",temp->data);
    else
            printf("\nElement %d is not found\n",val);
}

struct BST* deleteNode(struct BST* root, int val)
{
  if (root == NULL)
    return root;

  if (val < root->data)
    {
      root->lchild = deleteNode (root->lchild, val);
    }
  else if (val > root->data)
    {
      root->rchild = deleteNode (root->rchild, val);
    }
  else
    {
      if (root->lchild == NULL)
        {
            struct BST *temp = root->rchild;
            free (root);
            return temp;
        }
      else if (root->rchild == NULL)
        {
            struct BST *temp = root->lchild;
            free (root);
            return temp;
        }
      struct BST *temp = root->rchild;
      while (temp->lchild != NULL)
        {
            temp = temp->lchild;
        }
        root->data = temp->data;
        root->rchild = deleteNode (root->rchild, temp->data);
    }
  return root;
}
