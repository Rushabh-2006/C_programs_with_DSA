#include<stdio.h>
#define MAX 10

void bubbleSort(int A[], int n) {
    int i, j,temp;
    for (i=0; i<n-1; i++) {
        for (j=0; j<n-i-1; j++) {
            if (A[j] > A[j + 1]) {
                temp=A[j];
                A[j]= A[j+1];
                A[j+1]=temp;
            }
        }
    }
}
void main()
{
    int A[MAX],n,i;
    printf("\n Enter the length of Array:=> ");
    scanf("%d" ,&n);
    printf("\n Enter Elements of Array \n");
    for(i=0;i<n;i++)
    {
        printf("A[%d]= ",i);
        scanf("%d",&A[i]);
    }
    bubbleSort (A,n);

    printf("\n\nSorted List: \n");
    printf("---------\n");
    for(i=0;i<n;i++)
    {
        printf("%d ",A[i]);
    }
    printf("\n");
}
