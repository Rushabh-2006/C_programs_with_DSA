// call by value practical
#include<stdio.h>
void swap(int a, int b);
void main()
{
    int x,y;
    printf("Enter the value of x and y :");
    scanf("%d,%d",&x,&y);
    swap(x,y);
}
void swap(int a , int b)
{
    int temp;
    temp=a;
    a=b;
    b=temp;
    printf("After swapping the value: x=%d, y=%d", a,b);
}

